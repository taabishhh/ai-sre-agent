# Copy to .env and fill in what you have. Nothing here is required to run
# `python scripts/run_agent.py --mock` — see docs/TOOLS_NEEDED.md.

# --- Mode switches ---
MOCK_MODE=false          # true = use canned kubectl/helm/Prometheus fixtures, no cluster needed
AUTO_APPROVE=false        # DANGEROUS: true skips the human approval gate entirely

# --- LLM ---
ANTHROPIC_API_KEY= # enter your Anthropic API key here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929 # confirm the model name with Anthropic docs, as it may change over time

# --- Kubernetes / Helm ---
KUBECONFIG=                       # leave blank to use the default ~/.kube/config
DEFAULT_NAMESPACE=demo
ALLOWED_NAMESPACES=demo,default   # comma-separated allow-list for WRITE actions
MAX_REPLICA_SCALE=10
KUBECTL_TIMEOUT_S=20

# --- Prometheus ---
PROMETHEUS_URL=http://localhost:9090

# --- Slack ---
SLACK_WEBHOOK_URL=
